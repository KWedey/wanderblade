{
  "name": "wanderblade",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/core",
    "sim",
    "app"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p sim && tsc --noEmit -p app",
    "lint": "eslint .",
    "verify": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "sim": "npm run -w sim start --",
    "dev": "npm run -w app dev",
    "build": "npm run -w app build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
