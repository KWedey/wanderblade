{
  "name": "wanderblade",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/core",
    "sim",
    "app"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p sim && tsc --noEmit -p app",
    "lint": "eslint .",
    "verify": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run --exclude '**/node_modules/**' --exclude '**/.worktrees/**'",
    "sim": "npm run -w sim start --",
    "thumb": "npm run -w sim thumb --",
    "dev": "npm run -w app dev",
    "build": "npm run -w app build",
    "qa:capture": "node tools/qa/capture.mjs",
    "qa:pixels": "node tools/qa/pixels.mjs",
    "qa:speckle": "node tools/qa/speckle.mjs",
    "qa:mobile": "node tools/qa/mobile.mjs",
    "qa:wiring": "node tools/qa/wiring.mjs",
    "qa:loop": "node tools/qa/loop.mjs",
    "qa:miss": "node tools/qa/miss.mjs",
    "shop": "npm run -w sim shop --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "playwright": "^1.58.2"
  }
}
