{
  "name": "wanderblade",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "sim",
    "app"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p sim && tsc --noEmit -p app",
    "test": "vitest run",
    "sim": "npm run -w sim start --",
    "dev": "npm run -w app dev",
    "build": "npm run -w app build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
